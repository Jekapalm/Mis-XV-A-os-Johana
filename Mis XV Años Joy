Mis XV Años - Johana Jensine :root { --rose-gold: #b76e79; --rose-gold-light: #f3e5e8; --rose-gold-shiny: #e0a899; --text-dark: #3a3a3a; --envelope-bg: #dca7b0; } * { box-sizing: border-box; margin: 0; padding: 0; } body { font-family: 'Montserrat', sans-serif; background-color: #1a1516; color: var(--text-dark); text-align: center; overflow-x: hidden; padding: 0; } /* PANTALLA INICIAL: SOBRE DE LA REALEZA */ #envelope-wrapper { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(circle, #fff3f5 0%, var(--rose-gold-light) 100%); display: flex; justify-content: center; align-items: center; z-index: 9999; transition: transform 1s cubic-bezier(0.77, 0, 0.175, 1), opacity 0.8s ease; } .envelope { width: 320px; height: 220px; background-color: var(--envelope-bg); position: relative; border-radius: 4px; box-shadow: 0 15px 35px rgba(0,0,0,0.15); cursor: pointer; } /* Solapas del sobre simulación 3D */ .envelope::before { content: ""; position: absolute; top: 0; right: 0; border-width: 110px 160px 0 160px; border-style: solid; border-color: #e5b3bc transparent transparent transparent; z-index: 2; transform-origin: top; transition: transform 0.4s ease; } /* SELLO DE LACRE ANTIGUO */ .wax-seal { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 75px; height: 75px; background: radial-gradient(circle, var(--rose-gold-shiny) 20%, var(--rose-gold) 100%); border-radius: 50%; z-index: 10; box-shadow: 0 4px 10px rgba(139, 70, 80, 0.5), inset 0 0 8px rgba(0,0,0,0.2); display: flex; justify-content: center; align-items: center; border: 3px solid rgba(255, 255, 255, 0.1); animation: pulse 2s infinite; } /* Inicial J estilizada dentro del sello */ .wax-seal span { font-family: 'Alex Brush', cursive; font-size: 2.8rem; color: #fff3f5; font-weight: bold; text-shadow: 1px 2px 3px rgba(0,0,0,0.3); user-select: none; } @keyframes pulse { 0% { transform: translate(-50%, -50%) scale(1); } 50% { transform: translate(-50%, -50%) scale(1.05); } 100% { transform: translate(-50%, -50%) scale(1); } } .instruction-text { position: absolute; bottom: -45px; width: 100%; color: var(--rose-gold); font-size: 0.85rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; } /* CONTENEDOR PRINCIPAL PERGAMINO */ .container { max-width: 480px; margin: 20px auto; padding: 30px 20px; background-image: url('https://unsplash.com'); background-size: cover; background-position: center; border-radius: 8px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), inset 0 0 40px rgba(139, 115, 85, 0.2); position: relative; border: 2px solid #e2cfb4; opacity: 0; transform: translateY(40px); transition: all 1s ease 0.4s; } .container.show { opacity: 1; transform: translateY(0); } /* Secciones */ section { padding: 45px 15px; border-bottom: 1px dashed rgba(183, 110, 121, 0.3); } h1 { font-family: 'Alex Brush', cursive; font-size: 3.6rem; color: var(--rose-gold); margin-bottom: 10px; font-weight: 400; text-shadow: 1px 1px 1px rgba(255,255,255,0.8); } h2 { font-size: 1.4rem; color: var(--rose-gold); margin-bottom: 20px; letter-spacing: 2px; font-weight: 600; } .phrase { font-family: 'Playfair Display', serif; font-style: italic; font-weight: 400; margin: 20px 0; line-height: 1.6; color: #555555; } .parents { margin: 30px 0; font-size: 0.95rem; line-height: 1.8; } .parents strong { color: var(--rose-gold); display: block; font-weight: 600; } .card { background: rgba(255, 255, 255, 0.65); border: 1px solid rgba(183, 110, 121, 0.2); backdrop-filter: blur(3px); border-radius: 15px; padding: 25px; margin: 20px 0; } .btn-nav { display: inline-block; background: transparent; color: var(--rose-gold); border: 1px solid var(--rose-gold); padding: 10px 20px; border-radius: 20px; text-decoration: none; font-size: 0.9rem; font-weight: 600; margin-top: 15px; transition: all 0.3s ease; } .btn-nav:hover { background: var(--rose-gold); color: white; } /* Cuenta Regresiva */ #countdown { display: flex; justify-content: space-around; margin: 20px 0; } .time-box { background: rgba(183, 110, 121, 0.15); padding: 15px; border-radius: 10px; width: 75px; border: 1px solid rgba(183, 110, 121, 0.2); } .time-box span { display: block; font-size: 1.6rem; font-weight: 600; color: var(--rose-gold); } .time-box label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; color: #555; } .pass-selector { margin: 15px 0; padding: 15px; border: 1px dashed var(--rose-gold); border-radius: 10px; background: rgba(255, 255, 255, 0.7); } select { padding: 8px 15px; border-radius: 20px; border: 1px solid var(--rose-gold); color: var(--text-dark); font-weight: 600; outline: none; background: white; } .qr-frame { border: 2px solid var(--rose-gold-shiny); padding: 15px; background: white; display: inline-block; border-radius: 15px; margin-top: 15px; } .hashtag { font-size: 1.3rem; color: var(--rose-gold); font-weight: 600; letter-spacing: 1px; margin-top: 15px; display: block; } .btn-rsvp { display: block; background: linear-gradient(135deg, #25D366 0%, #128C7E 100%); color: white; border: none; padding: 15px; font-size: 1.1rem; font-weight: 600; border-radius: 30px; text-decoration: none; box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3); margin-top: 25px; } .sparkle { color: var(--rose-gold-shiny); font-size: 1.5rem; margin: 10px 0; } 

